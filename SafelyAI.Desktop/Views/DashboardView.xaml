<UserControl x:Class="SafelyAI.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}" Padding="24">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/><TextBlock Text="  ÉTAT DE L’APPAREIL" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,5"/>
            <TextBlock Text="{Binding DefenderStatus.Message}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastScan}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
          <Grid Grid.Column="1" Width="126" Height="126" Margin="24,0,6,0">
            <Ellipse Stroke="{DynamicResource BorderBrush2}" StrokeThickness="9"/>
            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="9" StrokeDashArray="4,2"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{Binding Session.Threats.Count}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="INDICATEURS" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="ANALYSES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Session.ScanHistory.Count}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,2"/><TextBlock Text="Scans locaux historisés" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="INDICATEURS DE CETTE SESSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Session.Threats.Count}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,2"/><TextBlock Text="À examiner; un résultat heuristique n’est pas une preuve." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="PROTECTION WINDOWS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding DefenderStatusLabel}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,2" TextWrapping="Wrap"/><TextBlock Text="{Binding DefenderSignatureLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Actualiser" Command="{Binding RefreshDefenderCommand}" IsEnabled="{Binding CanRefreshDefender}"/><Button Style="{StaticResource SecondaryButton}" Content="Ouvrir Sécurité Windows" Command="{Binding OpenWindowsSecurityCommand}"/></StackPanel></StackPanel></Border>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lancer une analyse" Style="{StaticResource H2}"/><TextBlock Text="Le moteur Microsoft Defender de Windows réalise l’analyse et applique sa politique de correction." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="MICROSOFT DEFENDER" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></Grid>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Content="⌕  Analyse rapide Defender" Command="{Binding DefenderQuickScanCommand}" IsEnabled="{Binding CanStartDefenderScan}"/>
            <Button Style="{StaticResource SecondaryButton}" Content="▤  Analyse complète Defender" Command="{Binding DefenderFullScanCommand}" IsEnabled="{Binding CanStartDefenderScan}"/>
            <Button Style="{StaticResource SecondaryButton}" Content="▧  Choisir un dossier" Command="{Binding DefenderCustomScanCommand}" IsEnabled="{Binding CanStartDefenderScan}"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="{Binding IsDefenderScanRunning}" Height="5" Margin="0,17,0,7" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush2}" BorderThickness="0"/>
          <TextBlock Text="{Binding DefenderScanStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="Le scanner local complémentaire, annulable et détaillé, reste disponible dans la page Antivirus." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Mode des analyses" Style="{StaticResource H2}"/><TextBlock Text="{Binding Session.ProtectionMode}" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,2"/><TextBlock Text="{Binding Session.DownloadMonitorIntervalLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Surveillance en arrière-plan" Foreground="{DynamicResource TextBrush}" Margin="0,20,0,0"/><TextBlock Text="Activation facultative dans Paramètres; limitée à Téléchargements." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Activité récente · historique local" Style="{StaticResource H2}"/><ItemsControl ItemsSource="{Binding Session.Activity}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Aucune activité enregistrée." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,14,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Session.Activity.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
