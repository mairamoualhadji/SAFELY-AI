<UserControl x:Class="SafelyAI.Desktop.Views.MaintenanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><StackPanel><TextBlock Text="Diagnostic de l’appareil" Style="{StaticResource H2}"/><TextBlock Text="Le diagnostic et l’aperçu n’effacent aucun fichier." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Analyser l’appareil" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding CanAnalyze}"/></DockPanel><TextBlock Text="{Binding SystemSummary}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/><TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
    <DockPanel Grid.Row="1" Margin="0,16,0,10"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Fichiers temporaires" Style="{StaticResource H2}"/><TextBlock Text="Sélectionnez seulement les fichiers que vous souhaitez supprimer." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding SelectedCount, StringFormat={}{0} sélectionné(s)}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource SecondaryButton}" Content="Nettoyer la sélection" Command="{Binding CleanSelectedCommand}" IsEnabled="{Binding CanClean}" Margin="0"/></StackPanel></DockPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Choisir" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="Nom" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Taille (octets)" Binding="{Binding Size}" IsReadOnly="True" Width="125"/><DataGridTextColumn Header="Chemin temporaire" Binding="{Binding Path}" IsReadOnly="True" Width="2*"/></DataGrid.Columns></DataGrid>
  </Grid>
</UserControl>
