<UserControl x:Class="SafelyAI.Desktop.Views.QuarantineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource DemoBanner}" Margin="0,0,0,14"><TextBlock Text="Les éléments sont isolés localement et peuvent être restaurés après vérification." Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/></Border>
    <Border Style="{StaticResource Card}"><DockPanel><StackPanel><TextBlock Text="Éléments isolés" Style="{StaticResource H2}"/><TextBlock Text="L’empreinte SHA-256 est vérifiée avant toute restauration." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, StringFormat={}{0} élément(s)}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></DockPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="190"><DataGrid.Columns><DataGridTextColumn Header="Fichier" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Emplacement d’origine" Binding="{Binding OriginalPath}" Width="2*"/><DataGridTextColumn Header="Mis en quarantaine" Binding="{Binding IsolatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="160"/><DataGridTextColumn Header="État" Binding="{Binding Status}" Width="115"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="Aucun élément en quarantaine pour le moment." Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Restaurer" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanAct}"/><Button Style="{StaticResource SecondaryButton}" Content="Supprimer définitivement" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanAct}"/></StackPanel></StackPanel></Border>
  </StackPanel>
</UserControl>
