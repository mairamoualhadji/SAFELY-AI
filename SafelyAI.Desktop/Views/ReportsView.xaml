<UserControl x:Class="SafelyAI.Desktop.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="SESSIONS DE SCAN" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ScanHistory.Count}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="ÉVÉNEMENTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Activity.Count}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,0"/></StackPanel></Border><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SecondaryButton}" Content="Actualiser les menaces" Command="{Binding RefreshThreatHistoryCommand}" Margin="8,0,0,0"/><Button Style="{StaticResource SecondaryButton}" Content="Actualiser Defender" Command="{Binding RefreshDefenderThreatHistoryCommand}" Margin="8,0,0,0"/><Button Style="{StaticResource PrimaryButton}" Content="Exporter le rapport" Command="{Binding ExportCommand}" Margin="8,0,0,0"/></StackPanel></Grid>
    <TextBlock Grid.Row="1" Text="Les scans et l’historique des menaces sont conservés localement. Les événements d’activité couvrent la session actuelle. Export en fichier texte." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,10"/>
    <TabControl Grid.Row="2"><TabItem Header="Analyses"><DataGrid ItemsSource="{Binding ScanHistory}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Portée" Binding="{Binding Scope}" Width="2*"/><DataGridTextColumn Header="Fichiers analysés" Binding="{Binding FilesScanned}" Width="125"/><DataGridTextColumn Header="Indicateurs" Binding="{Binding ThreatsFound}" Width="85"/><DataGridTextColumn Header="Date" Binding="{Binding FinishedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="155"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Menaces"><DataGrid ItemsSource="{Binding ThreatHistory}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Date de détection" Binding="{Binding DetectedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="155"/><DataGridTextColumn Header="État" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Niveau" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="Menace / indicateur" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*"/><DataGridTextColumn Header="Emplacement" Binding="{Binding Location}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Détections Defender"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding DefenderHistoryStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,4,4,8"/><DataGrid Grid.Row="1" ItemsSource="{Binding DefenderThreats}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Détection" Binding="{Binding InitialDetectionTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="155"/><DataGridTextColumn Header="Menace ID" Binding="{Binding ThreatId}" Width="110"/><DataGridTextColumn Header="État Defender" Binding="{Binding StatusLabel}" Width="150"/><DataGridTextColumn Header="Action de correction" Binding="{Binding ActionLabel}" Width="145"/><DataGridTextColumn Header="Ressources" Binding="{Binding ResourcesLabel}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Activité"><DataGrid ItemsSource="{Binding Activity}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="155"/><DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Événement" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Détails" Binding="{Binding Details}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
  </Grid>
</UserControl>
