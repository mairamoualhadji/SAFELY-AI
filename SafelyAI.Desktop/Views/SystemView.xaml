<UserControl x:Class="SafelyAI.Desktop.Views.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="PROCESSEUR" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Cpu}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,4"/><TextBlock Text="Utilisation agrégée" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="MÉMOIRE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Ram}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,4"/><TextBlock Text="Mémoire physique" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="STOCKAGE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Disk}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,4"/><TextBlock Text="Volumes fixes" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border>
    </Grid>
    <DockPanel Grid.Row="1" Margin="0,17,0,10"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Éléments du système" Style="{StaticResource H2}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox Width="180" Height="35" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filtrer par nom ou PID"/><Button Style="{StaticResource SecondaryButton}" Content="Actualiser" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/><Button Style="{StaticResource SecondaryButton}" Content="Détails Windows" Command="{Binding RefreshWindowsDetailsCommand}" Margin="0"/></StackPanel></DockPanel>
    <TabControl Grid.Row="2"><TabItem Header="Processus"><DataGrid ItemsSource="{Binding Processes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="85"/><DataGridTextColumn Header="Processus" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Mémoire (Mo)" Binding="{Binding MemoryMb, StringFormat={}{0:0.0}}" Width="120"/><DataGridTextColumn Header="Exécutable" Binding="{Binding Path}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="Services et tâches"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Services}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Services actifs" Binding="{Binding}" Width="*"/></DataGrid.Columns></DataGrid><DataGrid Grid.Column="1" ItemsSource="{Binding ScheduledTasks}" IsReadOnly="True" Margin="8,0,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tâches planifiées" Binding="{Binding}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Démarrage et USB"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding StartupPrograms}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Programmes au démarrage" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/><DataGridTextColumn Header="Commande" Binding="{Binding Command}" Width="2*"/></DataGrid.Columns></DataGrid><DataGrid Grid.Column="1" ItemsSource="{Binding UsbDevices}" IsReadOnly="True" Margin="8,0,0,0"><DataGrid.Columns><DataGridTextColumn Header="Périphériques USB" Binding="{Binding}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Matériel et journaux"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Démarrage sécurisé" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SecureBoot}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="TPM" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Tpm}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="BitLocker" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BitLocker}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Erreurs récentes du journal Système" Style="{StaticResource H2}" Margin="0,10,0,6"/><ItemsControl ItemsSource="{Binding RecentErrors}"/><TextBlock Text="Pilotes installés" Style="{StaticResource H2}" Margin="0,15,0,6"/><ItemsControl ItemsSource="{Binding Drivers}"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </Grid>
</UserControl>
