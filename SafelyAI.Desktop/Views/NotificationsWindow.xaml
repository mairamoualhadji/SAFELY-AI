<Window x:Class="SafelyAI.Desktop.Views.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notifications SAFELY AI" Width="520" Height="600" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Centre de notifications" Style="{StaticResource H1}"/><TextBlock Text="Alertes et événements de cette session." Style="{StaticResource PageDescription}" Margin="0,5,0,0"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Session.Notifications}" Background="Transparent" BorderThickness="0" Margin="0,16,0,12" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,4,12,0"/><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="{Binding Level}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryButton}" Content="Effacer l’historique" Command="{Binding ClearNotificationsCommand}"/><Button Style="{StaticResource PrimaryButton}" Content="Fermer" Margin="0" IsCancel="True"/></StackPanel>
  </Grid>
</Window>
