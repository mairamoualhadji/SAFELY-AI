<Window x:Class="SafelyAI.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFELY AI" Width="1440" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="18,22">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="7,2,0,30">
          <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="S" Foreground="{DynamicResource OnAccentBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
            <TextBlock Text="SAFELY AI" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="SÉCURITÉ WINDOWS" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="ESPACE DE PROTECTION" Style="{StaticResource Eyebrow}" Margin="10,0,0,9"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Key}" IsTabStop="False">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Glyph}" Width="29" FontSize="16" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="3" Style="{StaticResource SidebarStatusCard}" Margin="0,16,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/><TextBlock Text="  Scanner local actif" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
            <TextBlock Text="Analyse heuristique et empreintes locales. Ce prototype ne remplace pas un antivirus commercial." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,25,32,26">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding CurrentPageDescription}" Style="{StaticResource PageDescription}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource StatusPill}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/><TextBlock Text="  Interface locale" Foreground="{DynamicResource TextBrush}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
          </Border>
          <Button x:Name="NotificationsButton" Style="{StaticResource IconButton}" Click="NotificationsButton_OnClick" ToolTip="Notifications" Margin="0,0,8,0">
            <Grid><TextBlock Text="♧" FontSize="16"/><Border Background="{DynamicResource DangerBrush}" CornerRadius="9" MinWidth="16" Height="16" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10,-5,-7,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding NotificationCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding NotificationCount}" FontSize="9" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/></Border></Grid>
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Changer de thème"><TextBlock Text="{Binding ThemeGlyph}" FontSize="17"/></Button>
        </StackPanel>
      </Grid>
      <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
  </Grid>
</Window>
