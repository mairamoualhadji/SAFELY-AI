<UserControl x:Class="SafelyAI.Desktop.Views.NetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="PARE-FEU WINDOWS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding FirewallStatus}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="État en lecture seule" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="TRAFIC INTERFACE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding TrafficSummary}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="Compteurs cumulés des interfaces actives" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
    </Grid>
    <DockPanel Grid.Row="1" Margin="0,17,0,10"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Connexions TCP" Style="{StaticResource H2}"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Actualiser" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"/></DockPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"><DataGrid.Columns><DataGridTextColumn Header="État" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="Adresse locale" Binding="{Binding LocalAddress}" Width="*"/><DataGridTextColumn Header="Port local" Binding="{Binding LocalPort}" Width="100"/><DataGridTextColumn Header="Adresse distante" Binding="{Binding RemoteAddress}" Width="*"/><DataGridTextColumn Header="Port distant" Binding="{Binding RemotePort}" Width="100"/></DataGrid.Columns></DataGrid>
  </Grid>
</UserControl>
