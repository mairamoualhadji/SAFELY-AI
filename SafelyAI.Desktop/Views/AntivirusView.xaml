<UserControl x:Class="SafelyAI.Desktop.Views.AntivirusView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource DemoBanner}" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/><TextBlock Text="  Analyse locale en lecture seule · les indicateurs heuristiques nécessitent une vérification." Foreground="{DynamicResource TextBrush}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel><StackPanel><TextBlock Text="Lancer une analyse" Style="{StaticResource H2}"/><TextBlock Text="Les fichiers sont inspectés sans être exécutés ni modifiés." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Session.ProtectionMode}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Analyse rapide" Command="{Binding QuickScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Analyse complète" Command="{Binding FullScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Choisir un dossier" Command="{Binding CustomScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Arrêter" Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanRunning}"/></StackPanel>
      <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,17,0,7" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush2}" BorderThickness="0"/><TextBlock Text="{Binding Session.ScanStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><DockPanel><TextBlock Text="Menaces et indicateurs détectés" Style="{StaticResource H2}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Session.Threats.Count, StringFormat={}{0} élément(s)}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel><DataGrid ItemsSource="{Binding Session.Threats}" SelectedItem="{Binding SelectedThreat}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="210" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Nom / indicateur" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Emplacement" Binding="{Binding Location}" Width="2*"/><DataGridTextColumn Header="Niveau" Binding="{Binding Severity}" Width="100"/><DataGridTextColumn Header="Détecté le" Binding="{Binding DetectedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Ajouter la signature SHA-256" Command="{Binding RegisterSignatureCommand}" IsEnabled="{Binding CanQuarantine}"/><Button Style="{StaticResource SecondaryButton}" Content="Mettre en quarantaine" Command="{Binding QuarantineCommand}" IsEnabled="{Binding CanQuarantine}"/></StackPanel><TextBlock Text="Les heuristiques sont des signaux à vérifier. Une seule signature intégrée : le fichier de test inoffensif EICAR. Ajoutez uniquement des empreintes SHA-256 que vous avez vérifiées." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Historique des analyses" Style="{StaticResource H2}"/><DataGrid ItemsSource="{Binding ScanHistory}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="220" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Portée" Binding="{Binding Scope}" Width="2*"/><DataGridTextColumn Header="Fichiers" Binding="{Binding FilesScanned}" Width="120"/><DataGridTextColumn Header="Date" Binding="{Binding FinishedAt, StringFormat={}{0:dd/MM HH:mm}}" Width="125"/></DataGrid.Columns></DataGrid></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="Protection des fichiers" Style="{StaticResource H2}"/>
      <TextBlock Text="Surveillance à activer : journalise les changements et alerte en cas de rafale suspecte, sans bloquer les applications." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <WrapPanel><ComboBox Width="145" ItemsSource="{Binding RemovableDrives}" SelectedItem="{Binding SelectedRemovableDrive}" ToolTip="Clé USB amovible détectée"/><Button Style="{StaticResource SecondaryButton}" Content="Actualiser les clés USB" Command="{Binding RefreshUsbCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="Analyser la clé USB" Command="{Binding UsbScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="{Binding DownloadMonitorLabel}" Command="{Binding ToggleDownloadMonitoringCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="{Binding FolderMonitorLabel}" Command="{Binding ToggleFolderMonitoringCommand}"/></WrapPanel>
      <TextBlock Text="{Binding Session.MonitoredFolder}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,10"/>
      <TextBlock Text="Modifications surveillées récemment" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,3,0,6"/>
      <DataGrid ItemsSource="{Binding Session.FileChanges}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="70" MaxHeight="150"><DataGrid.Columns><DataGridTextColumn Header="Changement" Binding="{Binding ChangeType}" Width="100"/><DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding OccurredAt, StringFormat={}{0:dd/MM HH:mm:ss}}" Width="140"/></DataGrid.Columns></DataGrid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <DockPanel><StackPanel><TextBlock Text="Copies de sécurité" Style="{StaticResource H2}"/><TextBlock Text="Créez une copie à la demande; la restauration ne remplace jamais un fichier existant." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Sauvegarder un fichier…" Command="{Binding CreateBackupCommand}"/></DockPanel>
      <DataGrid ItemsSource="{Binding Session.Backups}" SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="170" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Fichier" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Emplacement d’origine" Binding="{Binding OriginalPath}" Width="2*"/><DataGridTextColumn Header="Copié le" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="155"/></DataGrid.Columns></DataGrid>
      <Button Style="{StaticResource SecondaryButton}" Content="Restaurer une copie sélectionnée…" Command="{Binding RestoreBackupCommand}" IsEnabled="{Binding CanRestoreBackup}" HorizontalAlignment="Right" Margin="0,9,0,0"/>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
