<UserControl x:Class="SafelyAI.Desktop.Views.AntivirusView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource DemoBanner}" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/><TextBlock Text="  Analyse locale en lecture seule · les indicateurs heuristiques nécessitent une vérification." Foreground="{DynamicResource TextBrush}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="Microsoft Defender · moteur antivirus Windows" Style="{StaticResource H2}"/>
      <TextBlock Text="Ces analyses utilisent le moteur et les signatures de Microsoft Defender. Windows peut afficher une demande UAC. Defender applique les règles de correction configurées dans Windows et affiche le détail dans l’historique de protection." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="Analyse rapide Defender" Command="{Binding DefenderQuickScanCommand}" IsEnabled="{Binding CanStartDefenderScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Analyse complète Defender" Command="{Binding DefenderFullScanCommand}" IsEnabled="{Binding CanStartDefenderScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Analyser un dossier avec Defender…" Command="{Binding DefenderCustomScanCommand}" IsEnabled="{Binding CanStartDefenderScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Analyser la clé USB avec Defender" Command="{Binding DefenderUsbScanCommand}" IsEnabled="{Binding CanStartDefenderScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Actualiser les signatures Defender" Command="{Binding UpdateDefenderSignaturesCommand}" IsEnabled="{Binding CanStartDefenderScan}"/></WrapPanel>
      <ProgressBar IsIndeterminate="{Binding IsDefenderScanRunning}" Height="4" Margin="0,12,0,6" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush2}" BorderThickness="0"/>
      <TextBlock Text="{Binding DefenderScanStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="Mises à jour des signatures" Style="{StaticResource H2}"/>
      <TextBlock Text="Flux de renseignements sur les menaces MalwareBazaar. Les empreintes téléchargées sont combinées avec la signature EICAR et vos signatures locales. Les signatures de flux sont des indicateurs de réputation et ne remplacent pas une analyse antivirus complète." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
      <WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="Configurer la clé du flux…" Command="{Binding ConfigureSignatureFeedCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="Actualiser maintenant" Command="{Binding UpdateSignatureFeedCommand}" IsEnabled="{Binding CanUpdateSignatureFeed}"/><Button Style="{StaticResource SecondaryButton}" Content="Supprimer la clé API…" Command="{Binding RemoveSignatureFeedKeyCommand}" IsEnabled="{Binding CanUpdateSignatureFeed}"/></WrapPanel>
      <ProgressBar IsIndeterminate="{Binding IsUpdatingSignatureFeed}" Height="4" Margin="0,8,0,6" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush2}" BorderThickness="0"/>
      <TextBlock Text="{Binding SignatureFeedStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel><StackPanel><TextBlock Text="Lancer une analyse" Style="{StaticResource H2}"/><TextBlock Text="Les fichiers sont inspectés sans être exécutés ni modifiés." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Session.ProtectionMode}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Analyse rapide" Command="{Binding QuickScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Analyse complète" Command="{Binding FullScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Choisir un dossier" Command="{Binding CustomScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="Arrêter" Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanRunning}"/></StackPanel>
      <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,17,0,7" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush2}" BorderThickness="0"/><TextBlock Text="{Binding Session.ScanStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><DockPanel><TextBlock Text="Menaces et indicateurs détectés" Style="{StaticResource H2}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Session.Threats.Count, StringFormat={}{0} élément(s)}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel><DataGrid ItemsSource="{Binding Session.Threats}" SelectedItem="{Binding SelectedThreat}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="210" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Nom / indicateur" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Emplacement" Binding="{Binding Location}" Width="2*"/><DataGridTextColumn Header="Niveau" Binding="{Binding Severity}" Width="100"/><DataGridTextColumn Header="Détecté le" Binding="{Binding DetectedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Expliquer avec l’IA locale" Command="{Binding ExplainThreatCommand}" IsEnabled="{Binding CanExplainThreat}"/><Button Style="{StaticResource SecondaryButton}" Content="Ajouter la signature SHA-256" Command="{Binding RegisterSignatureCommand}" IsEnabled="{Binding CanQuarantine}"/><Button Style="{StaticResource SecondaryButton}" Content="Mettre en quarantaine" Command="{Binding QuarantineCommand}" IsEnabled="{Binding CanQuarantine}"/></StackPanel><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0"><TextBlock Text="{Binding ThreatExplanationText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></Border><TextBlock Text="L’explication IA est une aide, pas un verdict. Les noms, empreintes et chemins ne sont pas envoyés à un service Internet; le modèle Ollama doit tourner localement. Vérifiez les alertes avant toute action." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Historique des analyses" Style="{StaticResource H2}"/><DataGrid ItemsSource="{Binding ScanHistory}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="220" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Portée" Binding="{Binding Scope}" Width="2*"/><DataGridTextColumn Header="Fichiers" Binding="{Binding FilesScanned}" Width="120"/><DataGridTextColumn Header="Date" Binding="{Binding FinishedAt, StringFormat={}{0:dd/MM HH:mm}}" Width="125"/></DataGrid.Columns></DataGrid></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="Protection des fichiers" Style="{StaticResource H2}"/>
      <TextBlock Text="La surveillance des téléchargements est activée à la demande. Une empreinte SHA-256 exacte provenant d’une signature locale ou du flux est isolée en quarantaine; les alertes heuristiques restent à vérifier. La surveillance d’un dossier de travail alerte sur les rafales mais ne bloque pas les applications." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <WrapPanel><ComboBox Width="145" ItemsSource="{Binding RemovableDrives}" SelectedItem="{Binding SelectedRemovableDrive}" ToolTip="Clé USB amovible détectée"/><Button Style="{StaticResource SecondaryButton}" Content="Actualiser les clés USB" Command="{Binding RefreshUsbCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="Analyser la clé USB" Command="{Binding UsbScanCommand}" IsEnabled="{Binding CanStartScan}"/><Button Style="{StaticResource SecondaryButton}" Content="{Binding DownloadMonitorLabel}" Command="{Binding ToggleDownloadMonitoringCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="{Binding FolderMonitorLabel}" Command="{Binding ToggleFolderMonitoringCommand}"/></WrapPanel>
      <TextBlock Text="{Binding Session.MonitoredFolder}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,10"/>
      <TextBlock Text="Modifications surveillées récemment" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,3,0,6"/>
      <DataGrid ItemsSource="{Binding Session.FileChanges}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="70" MaxHeight="150"><DataGrid.Columns><DataGridTextColumn Header="Changement" Binding="{Binding ChangeType}" Width="100"/><DataGridTextColumn Header="Fichier" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding OccurredAt, StringFormat={}{0:dd/MM HH:mm:ss}}" Width="140"/></DataGrid.Columns></DataGrid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <DockPanel><StackPanel><TextBlock Text="Copies de sécurité" Style="{StaticResource H2}"/><TextBlock Text="Créez une copie à la demande; la restauration ne remplace jamais un fichier existant." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Sauvegarder un fichier…" Command="{Binding CreateBackupCommand}"/></DockPanel>
      <DataGrid ItemsSource="{Binding Session.Backups}" SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="170" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Fichier" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Emplacement d’origine" Binding="{Binding OriginalPath}" Width="2*"/><DataGridTextColumn Header="Copié le" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="155"/></DataGrid.Columns></DataGrid>
      <Button Style="{StaticResource SecondaryButton}" Content="Restaurer une copie sélectionnée…" Command="{Binding RestoreBackupCommand}" IsEnabled="{Binding CanRestoreBackup}" HorizontalAlignment="Right" Margin="0,9,0,0"/>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
