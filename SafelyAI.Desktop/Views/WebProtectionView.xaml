<UserControl x:Class="SafelyAI.Desktop.Views.WebProtectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource DemoBanner}" Margin="0,0,0,14"><TextBlock Text="L’analyse URL est heuristique et locale. Elle ne consulte pas de service de réputation en ligne et ne garantit pas qu’un site soit sûr." Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Analyser un lien" Style="{StaticResource H2}"/><TextBlock Text="Examinez l’URL, les sous-domaines, certains mots et les formes suspectes." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Height="39" VerticalContentAlignment="Center" ToolTip="https://exemple.com"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Analyser localement" Command="{Binding AnalyzeUrlCommand}" Margin="10,0,0,0"/></Grid>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource StatusPill}" Padding="14,9"><StackPanel Orientation="Horizontal"><TextBlock Text="RISQUE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><TextBlock Text="{Binding RiskLevel}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBlock Text="{Binding RiskScore, StringFormat={}{0}/100}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Border><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
      <ItemsControl ItemsSource="{Binding Findings}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="CERTIFICAT HTTPS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding CertificateSummary}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Style="{StaticResource SecondaryButton}" Content="Vérifier le certificat" Command="{Binding CheckCertificateCommand}" IsEnabled="{Binding CanCheckCertificate}" HorizontalAlignment="Left" Margin="0"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="TÉLÉCHARGEMENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding DownloadSummary}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Style="{StaticResource SecondaryButton}" Content="Choisir un fichier" Command="{Binding AnalyzeDownloadCommand}" HorizontalAlignment="Left" Margin="0"/></StackPanel></Border>
    </Grid>
  </StackPanel></ScrollViewer>
</UserControl>
