<UserControl x:Class="SafelyAI.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Apparence" Style="{StaticResource H2}"/><TextBlock Text="Choisissez le thème de l’application." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,14"/><CheckBox Content="Utiliser le thème sombre" IsChecked="{Binding IsDarkMode}" Foreground="{DynamicResource TextBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Mode de protection" Style="{StaticResource H2}"/><TextBlock Text="Le mode ajuste la fréquence de stabilisation des nouveaux téléchargements quand leur surveillance est activée. Les scans lancés par l’utilisateur restent manuels." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,13"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/><TextBlock Text="{Binding ModeDescription}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="Surveillance en arrière-plan" Style="{StaticResource H2}"/>
      <TextBlock Text="L’agent s’exécute dans votre session Windows, vérifie jusqu’à 20 000 fichiers déjà présents au premier niveau de Téléchargements puis surveille les nouveaux fichiers stabilisés. Pour ces nouveaux fichiers, il tente aussi un scan personnalisé Microsoft Defender sans afficher de fenêtre UAC; si Windows refuse la demande faute de droits, le scan local SAFELY AI continue et l’échec est journalisé. L’agent démarre à la prochaine ouverture de session et applique le mode de performance enregistré au lancement. Une empreinte SHA-256 exacte est isolée dans la quarantaine locale. Aucun pilote noyau n’est installé; cette surveillance ne bloque pas l’exécution d’un fichier avant son ouverture." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="Activer et démarrer" Command="{Binding EnableBackgroundProtectionCommand}" IsEnabled="{Binding CanEnableBackgroundProtection}"/><Button Style="{StaticResource SecondaryButton}" Content="Désactiver" Command="{Binding DisableBackgroundProtectionCommand}" IsEnabled="{Binding IsBackgroundProtectionEnabled}"/></WrapPanel>
      <TextBlock Text="{Binding BackgroundProtectionStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="Journal local : %LOCALAPPDATA%\SafelyAI\Logs\background-protection.log" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="État des fonctionnalités" Style="{StaticResource H2}"/><UniformGrid Columns="2" Margin="0,13,0,0"><TextBlock Text="Interface et navigation" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9"/><TextBlock Text="Disponible" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Analyses antivirus" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9"/><TextBlock Text="Microsoft Defender + scanner local complémentaire" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/><TextBlock Text="Audit système / réseau" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9"/><TextBlock Text="Outils locaux à la demande" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Réputation Web" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Indicateurs à confirmer" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="Explication par IA" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Ollama local facultatif" Foreground="{DynamicResource AccentBrush}"/></UniformGrid></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
