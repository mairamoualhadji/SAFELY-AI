<UserControl x:Class="SafelyAI.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="32" Width="420" HorizontalAlignment="Left">
    <TextBlock Text="Paramètres" Style="{StaticResource H1}"/>
    <CheckBox Content="Mode sombre" IsChecked="{Binding IsDarkMode}" Margin="0,20,0,0" Foreground="{DynamicResource TextBrush}"/>
    <TextBlock Text="Mode de protection" Margin="0,20,0,6" Foreground="{DynamicResource MutedBrush}"/>
    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
    <TextBlock Margin="0,6,0,0" Text="Economy = économie, Balanced = équilibré, Maximum = protection maximale" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>
</UserControl>
