<UserControl x:Class="SafelyAI.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Apparence" Style="{StaticResource H2}"/><TextBlock Text="Choisissez le thème de l’application." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,14"/><CheckBox Content="Utiliser le thème sombre" IsChecked="{Binding IsDarkMode}" Foreground="{DynamicResource TextBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Mode de protection" Style="{StaticResource H2}"/><TextBlock Text="Le mode ajuste la fréquence de stabilisation des nouveaux téléchargements quand leur surveillance est activée. Les scans lancés par l’utilisateur restent manuels." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,13"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/><TextBlock Text="{Binding ModeDescription}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="État des fonctionnalités" Style="{StaticResource H2}"/><UniformGrid Columns="2" Margin="0,13,0,0"><TextBlock Text="Interface et navigation" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9"/><TextBlock Text="Disponible" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Analyse antivirus" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9"/><TextBlock Text="Locale · prototype" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="Audit système / réseau" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9"/><TextBlock Text="Lecture locale" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Réputation Web" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Heuristiques à vérifier" Foreground="{DynamicResource WarningBrush}"/></UniformGrid></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
