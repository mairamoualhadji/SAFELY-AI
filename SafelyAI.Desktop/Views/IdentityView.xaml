<UserControl x:Class="SafelyAI.Desktop.Views.IdentityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><DockPanel><StackPanel><TextBlock Text="Audit des comptes locaux" Style="{StaticResource H2}"/><TextBlock Text="La lecture ne modifie aucun compte ni paramètre Windows." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Lancer l’audit" Command="{Binding AuditCommand}" IsEnabled="{Binding CanAudit}"/></DockPanel></Border>
    <Grid Grid.Row="1" Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="COMPTES LOCAUX" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Accounts.Count}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="ÉCHECS DE CONNEXION · 24 H" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding FailedLogins}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,9,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="CHANGEMENTS DE PRIVILÈGES · 24 H" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PrivilegeChanges}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,9,0,0"/></StackPanel></Border></Grid>
    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="SESSIONS WINDOWS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Sessions}" Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" MaxHeight="60"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="POLITIQUE DE MOT DE PASSE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PasswordPolicySummary}" Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></Grid>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/><DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Compte" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Activé" Binding="{Binding Enabled}" Width="80"/><DataGridCheckBoxColumn Header="Administrateur" Binding="{Binding IsAdmin}" Width="125"/><DataGridTextColumn Header="Mot de passe requis" Binding="{Binding PasswordRequired}" Width="150"/><DataGridTextColumn Header="Dernière connexion" Binding="{Binding LastLogon}" Width="160"/></DataGrid.Columns></DataGrid></Grid>
  </Grid>
</UserControl>
